{
    "version": "1.2.2",
    "description": "Encrypted point-to-point networking with UDP hole punching and HTTPS relay fallback",
    "homepage": "https://github.com/k0ngk0ng/wire-connect",
    "architecture": {
        "64bit": {
            "url": "https://github.com/k0ngk0ng/wire-connect/releases/download/v1.2.2/wire-connect-1.2.2-windows-amd64.zip",
            "hash": "1eb02a1ccccb1ca07c81e4f69dc019fb346097525f26c12e55c4ae792b7fb2b4"
        }
    },
    "depends": [
        "k0ngk0ng/wirectl"
    ],
    "bin": "bin/wirectl-connect.exe",
    "post_install": [
        "$binary = Join-Path $dir 'bin\\wirectl-connect.exe'",
        "if (!(Test-Path -LiteralPath $binary -PathType Leaf)) { throw 'wirectl-connect.exe was not installed' }",
        "$marker = Join-Path (Split-Path -Parent $binary) '.wire-connect-package-manager'",
        "[IO.File]::WriteAllText($marker, 'scoop', [Text.UTF8Encoding]::new($false))"
    ],
    "notes": [
        "Run 'wirectl connect setup' as your regular user to authorize the network helper.",
        "After 'scoop update wirectl wire-connect', run setup to refresh the helper and resume for each connection you want active."
    ],
    "checkver": {
        "github": "https://github.com/k0ngk0ng/wire-connect"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/k0ngk0ng/wire-connect/releases/download/v$version/wire-connect-$version-windows-amd64.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS"
        }
    },
    "license": "MIT"
}
